<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;; MELBIS-V1
;;;;; To cite:
;;;;; Perez, L., Dragicevic, S., & Gaudreau, J. (2019).
;;;;; A geospatial agent-based model of the spatial urban dynamics of immigrant population: A study of the island of Montreal, Canada.
;;;;; PLOS ONE, 14(7), e0219188. https://doi.org/10.1371/journal.pone.0219188





extensions [gis]

globals[
  africansDs
  asiansDs
  americansDs
  europeansDs
  childrenDs
  enFrDs
  englishDs
  frenchDs
  medAgeDs
  medIncomeDs
  populationDs
  mtlDs
  busDs
  schoolsDs
  metroDs
  parksDs
  commerceDs
  pFactor ;Define the population factor to apply to the number of agents to get the corresponding number of people
]

patches-own[
  africans
  asians
  americans
  europeans
  children
  enFr
  english
  french
  medAge
  medIncome
  population
  is_mtl
  bus
  school
  metro
  park
  commerce
  africanMean
  americanMean
  asianMean
  europeanMean
  frenchMean
  englishMean
  enFrMean
  schoolsMean
  metros
  buses
  parks
  commerces
  schools
]

breed[Immigrants Immigrant]

Immigrants-own[
  nbChildren
  ;How many children?

  ethnicity
  ;What is the ethnicity?

  age
  ;What is the age of the immigrant?

  married?
  ;Is the immigrant a married couple?

  income
  ;Annual Income

  typeImmigrant
  ;Type of immigant: 1. Student 2. Skilled Worker 3. Refugee 4. ???

  language
  ;Spoken language: French, English or Both

  defined?
  ;Are the agents sorted in groups?

  education
  ;What is the level of education. Superior or None
  satisfied?
  ;Are the agents satisfied by their location?

  step
  ;Where are the agents in their decision process. Starts with Step1.

;  Choice0
  Choice1
  Choice2
  Choice3
  Choice4
  Choice5

]

breed[Residents Resident]



to setup
  ca
  reset-ticks
  ;set-default-shape Residents "house"
  ;set-default-shape Immigrants "house"
  set pFactor 1
  importGis
  createPeople
  giveValueToImmigrants
end

to go
  compute_neighborhoods
  select_choice1
  select_choice2
  select_choice3
  select_choice4
  select_choice5
  ; ask Immigrants [move-to one-of Choice5]
  segregate
  satisfaction
  udpate_pop_in_neighborhood
tick
end

to Export_To_Shapefile
  gis:set-world-envelope-ds gis:envelope-of mtlDs

  ask Immigrants [set Choice1 count Choice1 set Choice2 count Choice2 set Choice3 count Choice3 set Choice4 count Choice4 set Choice5 count Choice5]
    let carte gis:turtle-dataset Immigrants
  gis:store-dataset carte user-new-file
end

to compute_neighborhoods
  print "Computing mean values of neighborhoods"
  print "Computing african mean"
  ask patches with [africans > 0] [set africanMean mean [africans] of patches in-radius 4 with [africans > 0]]
  print "Computing american mean"
  ask patches with [americans > 0] [set americanMean mean [americans] of patches in-radius 4 with [americans > 0]]
  print "Computing asian mean"
  ask patches with [asians > 0] [set asianMean mean [asians] of patches in-radius 4 with [asians > 0]]
  print "Computing european mean"
  ask patches with [europeans > 0] [set europeanMean mean [europeans] of patches in-radius 4 with [europeans > 0]]
  print "Computing french language mean"
  ask patches with [french > 0] [set frenchMean mean [french] of patches in-radius 12 with [french > 0]]
  print "Computing english language mean"
  ask patches with [english > 0] [set englishMean mean [english] of patches in-radius 12 with [english > 0]]
  print "Computing english/french mean"
  ask patches with [enFr > 0] [set enFrMean mean [enFr] of patches in-radius 12 with [enFr > 0]]
  print "Computing bus count"
  ask patches with [is_mtl = 1] [set buses count patches in-radius 8 with [bus = 1]]
  print "Computing metro count"
  ask patches with [is_mtl = 1] [ set metros count patches in-radius 8 with [metro = 1]]
  print "computing school count"
  ask patches with [is_mtl = 1] [ set schools count patches in-radius 16 with [school = 1]]
  print "computing park count"
  ask patches with [is_mtl = 1] [ set parks count patches in-radius 16 with [park = 1]]
  print "computing commerce count"
  ask patches with [is_mtl = 1] [ set commerces count patches in-radius 32 with [commerce = 1]]

  print "finished mean values computation"

end

to udpate_pop_in_neighborhood
  print "Update neighborhood immigrants percents"
  ask patches with [any? Immigrants-here] [
    if (africans <= 0) or (africans >= 0) [
      set africans 100 * (africans / 100 * population + pFactor * count Immigrants-here with [ethnicity = "african"]) / (population + pFactor * count Immigrants-here with [ethnicity = "african"])] 
    if (americans <= 0) or (americans >= 0) [
      set americans 100 * (americans / 100 * population + pFactor * count Immigrants-here with [ethnicity = "american"]) / (population + pFactor * count Immigrants-here with [ethnicity = "american"])]
    if (asians <= 0) or (asians >= 0) [
      set asians 100 * (asians / 100 * population + pFactor * count Immigrants-here with [ethnicity = "asian"]) / (population + pFactor * count Immigrants-here with [ethnicity = "asian"])]
    if (europeans <= 0) or (europeans >= 0) [
      set europeans 100 * (europeans / 100 * population + pFactor * count Immigrants-here with [ethnicity = "european"]) / (population + pFactor * count Immigrants-here with [ethnicity = "european"])]
    if (french <= 0) or (french >= 0) [
      set french 100 * (french / 100 * population + pFactor * count Immigrants-here with [language = "French" or language = "Both"]) / (population + pFactor * count Immigrants-here with [language = "French" or language = "Both"]) ]
    if (english <= 0) or (english >= 0) [
      set english 100 * (english / 100 * population + pFactor * count Immigrants-here with [language = "English" or language = "Both"]) / (population + pFactor * count Immigrants-here with [language = "English" or language = "Both"])]
  ]
end 

;;;;;;;;;;;;;;;;;;; The following "choices" are the five rules used to determine where the immigrants go. These choice procedures repeatedly subset a set of suitable patches. -JLK

to select_choice1
;;;;;;;;;;;;;;;;;;; Choice 1 is based on ethnicity and language -JLK
  print "selection of best areas for african speaking french"
  if count patches with [not any? Residents-here and africanMean > desired_neighbors and frenchMean > 50] > 0
    [ask immigrants with [ethnicity = "african" and language = "French"] [
      set choice1 patches with [not any? Residents-here and africanMean > desired_neighbors and frenchMean > 50]]]

  print "selection of best areas for african speaking english"
  if count patches with [not any? Residents-here and africanMean > desired_neighbors and englishMean > 50] > 0
    [ask immigrants with [ethnicity = "african" and language = "English"] [
      set choice1 patches with [not any? Residents-here and africanMean > desired_neighbors and englishMean > 50]]] 
  
  print "selection of best areas for african speaking engligh and french"
  if count patches with [not any? Residents-here and africanMean > desired_neighbors and (english > 50 or french > 50)] > 0
    [ask immigrants with [ethnicity = "african" and language = "Both"] [
      set choice1 patches with [not any? Residents-here and africanMean > desired_neighbors and (english > 50 or french > 50)]]]
  
  print "selection of best areas for american speaking french"
  if count patches with [not any? Residents-here and americanMean > desired_neighbors and frenchMean > 50] > 0
    [ask immigrants with [ethnicity = "american" and language = "French"] [
      set choice1 patches with [not any? Residents-here and americanMean > desired_neighbors and frenchMean > 50]]]
  
  print "selection of best areas for american speaking english"
  if count patches with [not any? Residents-here and americanMean > desired_neighbors and englishMean > 50] > 0
    [ask immigrants with [ethnicity = "american" and language = "English"] [
      set choice1 patches with [not any? Residents-here and americanMean > desired_neighbors and englishMean > 50]]] 
  
  print "selection of best areas for american speaking engligh and french"
  if count patches with [not any? Residents-here and americanMean > desired_neighbors and (english > 50 or french > 50)] > 0
    [ask immigrants with [ethnicity = "american" and language = "Both"] [
      set choice1 patches with [not any? Residents-here and americanMean > desired_neighbors and (english > 50 or french > 50)]]] 
  
  print "selection of best areas for asian speaking french"
  if count patches with [not any? Residents-here and asianMean > desired_neighbors and frenchMean > 50] > 0
    [ask immigrants with [ethnicity = "asian" and language = "French"] [
      set choice1 patches with [not any? Residents-here and asianMean > desired_neighbors and frenchMean > 50]]]
  
  print "selection of best areas for asian speaking english"
  if count patches with [not any? Residents-here and asianMean > desired_neighbors and englishMean > 50] > 0
    [ask immigrants with [ethnicity = "asian" and language = "English"] [
      set choice1 patches with [not any? Residents-here and asianMean > desired_neighbors and englishMean > 50]]] 
  
  print "selection of best areas for asian speaking engligh and french"
  if count patches with [not any? Residents-here and asianMean > desired_neighbors and (english > 50 or french > 50)] > 0
    [ask immigrants with [ethnicity = "asian" and language = "Both"] [
      set choice1 patches with [not any? Residents-here and asianMean > desired_neighbors and (english > 50 or french > 50)]]] 
  
  print "selection of best areas for european speaking french"
  if count patches with [not any? Residents-here and europeanMean > desired_neighbors and frenchMean > 50] > 0
    [ask immigrants with [ethnicity = "european" and language = "French"] [
      set choice1 patches with [not any? Residents-here and europeanMean > desired_neighbors and frenchMean > 50]]]
  
  print "selection of best areas for european speaking english"
  if count patches with [not any? Residents-here and europeanMean > desired_neighbors and englishMean > 50] > 0
    [ask immigrants with [ethnicity = "european" and language = "English"] [
      set choice1 patches with [not any? Residents-here and europeanMean > desired_neighbors and englishMean > 50]]] 
  
  print "selection of best areas for european speaking engligh and french"
  if count patches with [not any? Residents-here and europeanMean > desired_neighbors and (english > 50 or french > 50)] > 0
    [ask immigrants with [ethnicity = "european" and language = "Both"] [
      set choice1 patches with [not any? Residents-here and europeanMean > desired_neighbors and (english > 50 or french > 50)]]] 
end

to select_choice2
;;;;;;;;;;;;;;;; Choice 2 is based on income -JLK
  print "Subsetting patches from choice1 in regards to the income"
  ask Immigrants with [count Choice1 > 1] [
    if (count Choice1 with [medincome > [income] of myself - 10000 and medincome < [income] of myself + 5000] > 0) 
      [set Choice2 Choice1 with [medincome > [income] of myself - 10000 and medincome < [income] of myself + 5000]]]
  print "Finished"
end

to select_choice3
;;;;;;;;;;;;;;;; Choice 3 is based on access to schools -JLK
  print "Subsetting patches from Choice2 in regards to the schools for people with children"
  ask Immigrants with [nbChildren > 0] [
    if count Choice2 with [schools > 0] > 0 [
      set Choice3 Choice2 with [schools > 0]]]
  ask Immigrants with [nbChildren = 0] [set Choice3 Choice2]
end

to select_choice4
;;;;;;;;;;;;;;;; Choice 4 is based on neighborhood quality (parks and commerce) -JLK
  ask Immigrants [set defined? false]
  ask Immigrants with [typeImmigrant = "Business"] [if count Choice3 with [parks > 0 and commerces > 0] > 0 
    [set Choice4 Choice3 with [parks > 0 and commerces > 0] set defined? true]]
  ask n-of (0.5 * count Immigrants with [typeImmigrant = "Skilled Worker"]) Immigrants with [typeImmigrant = "Skilled Worker"] [if count Choice3 with [parks > 0 and commerces > 0] > 0 
    [set Choice4 Choice3 with [parks > 0 and commerces > 0] set defined? true]]
  ;ask Immigrants with [defined? != true] [set Choice4 Choice3]
end

to select_choice5
;;;;;;;;;;;;;;;; Choice 5 is based on access to public transit -JLK
  ask Immigrants [if count Choice4 with [(buses > nbBus) or (metros > 0)] > 0 
    [set Choice5 Choice4 with [buses > nbBus or metros > 0]]]
end

to importGis
  print "Importing GIS Layers..."
  ask patches [set pcolor white]
  set mtlDs gis:load-dataset "../data/mtl.asc"
  gis:set-world-envelope-ds gis:envelope-of mtlDs
  gis:apply-raster mtlDs is_mtl
  ask patches with [is_mtl = 1] [set pcolor gray + 1]
  gis:import-wms-drawing "https://maps.geogratis.gc.ca/wms/CBMT?service=wms&version=1.3.0" "EPSG:4326" "Sub_regional" 100
  
;;;;;;;;;;;;;;;;;;;;;;;; Population datasets represent the percentage of population with the given variable present in a cell -JLK

  set africansDs gis:load-dataset "../data/2011_africans.asc"
  gis:apply-raster africansDs africans
  ;ask patches with [africans > 20] [set pcolor black]

  set asiansDs gis:load-dataset "../data/2011_asians.asc"
  gis:apply-raster asiansDs asians
  ;ask patches with [asians > 20] [set pcolor orange]

  set americansDs gis:load-dataset "../data/2011_americans.asc"
  gis:apply-raster americansDs americans
  ;ask patches with [americans > 20] [set pcolor green]

  set europeansDs gis:load-dataset "../data/2011_europeans.asc"
  gis:apply-raster europeansDs europeans
  ;ask patches with [europeans > 20] [set pcolor red]

  set childrenDs gis:load-dataset "../data/2011_children.asc"
  gis:apply-raster childrenDs children
  ;ask patches with [children > 1] [set pcolor blue]

  set enFrDs gis:load-dataset "../data/2011_En_Fr.asc"
  gis:apply-raster enFrDs enFr
  ;ask patches with [enFr > 20] [set pcolor brown]

  set englishDs gis:load-dataset "../data/2011_English.asc"
  gis:apply-raster englishDs english
  ;ask patches with [english > 30] [set pcolor blue]

  set frenchDs gis:load-dataset "../data/2011_french.asc"
  gis:apply-raster frenchDs french
  ;ask patches with [french > 30] [set pcolor pink]

  set medAgeDs gis:load-dataset "../data/2011_medAge.asc"
  gis:apply-raster medAgeDs medAge
  ;ask patches with [medAge > 50] [set pcolor green]

  set medIncomeDs gis:load-dataset "../data/2011_MedIncome.asc"
  gis:apply-raster medIncomeDs medIncome
  ;ask patches with [medIncome > 50000] [set pcolor red]

  set populationDs gis:load-dataset "../data/2011_pop.asc"
  gis:apply-raster populationDs population
  ;ask patches with [population > 3000] [set pcolor white]

;;;;;;;;;;;;;;;;;;;;;;;; The following variables are represented as binary rasters -JLK

  set busDs gis:load-dataset "../data/2011_bus.asc"
  gis:apply-raster busDs bus
  ask patches with [bus = -3.4] [set bus 0]

  set schoolsDs gis:load-dataset "../data/2011_schools.asc"
  gis:apply-raster schoolsDs school
  ask patches with [school = -3.4] [set school 0]

  set metroDs gis:load-dataset "../data/2011_metro.asc"
  gis:apply-raster metroDs metro
  ask patches with [metro = -3.4] [set metro 0]

  set parksDs gis:load-dataset "../data/2011_parks.asc"
  gis:apply-raster parksDs park
  ask patches with [park = -3.4] [set park 0]

  set commerceDs gis:load-dataset "../data/2011_commerce.asc"
  gis:apply-raster commerceDs commerce
  ask patches with [commerce = -3.4] [set commerce 0]

  print "layer importation successful"

end


to createPeople
;;;;;;;;;;;;;;;;;;;;;;;; Residents do not move, Immigrants will move -JLK
  print "Creating residents and immigrants"
  ask n-of 6667 patches with [is_mtl = 1] [sprout-Residents 1 [set color blue set size 1 ]]
  ask n-of 3333 patches with [is_mtl = 1 and not any? turtles-here] [sprout-Immigrants 1 [set size 1 set satisfied? false set step 1]]
  ask Immigrants [set choice1 no-patches]
  ask Immigrants [set choice2 no-patches]
  ask Immigrants [set choice3 no-patches]
  ask Immigrants [set choice4 no-patches]
  ask Immigrants [set choice5 no-patches]
end

to giveValueToImmigrants
;;;;;;;;;;;;;;;;;;;;;;;; This procedure gives a demographic profile to each immigrant based on statistics of immigration in Quebec in 2010 -JLK
  ask n-of (0.368 * 3333) Immigrants [set color black set nbChildren random 4 set ethnicity "african" set defined? true]
  ask n-of (0.212 * 3333) Immigrants with [defined? != true] [set color pink set nbChildren random 4 set ethnicity "american" set defined? true]
  ask n-of (0.254 * 3333) Immigrants with [defined? != true] [set color yellow set nbChildren random 4 set ethnicity "asian" set defined? true]
  ask Immigrants with [defined? != true] [set color white set nbChildren random 4 set ethnicity "european"]
  ask Immigrants [set defined? false]
  ask n-of (0.78 * 3333) Immigrants [set typeImmigrant "Skilled Worker" set defined? true]
  ask n-of (0.09 * 3333) Immigrants with [defined? != true] [set typeImmigrant "Business" set defined? true]
  ask Immigrants with [defined? != true] [set typeImmigrant "Refugee"]
  ask Immigrants[set defined? false]
  ask n-of (0.7 * 3333) Immigrants [set age 18 + random 18 set defined? true]
  ask Immigrants with [defined? != true] [set age 36 + random 11]
  ask Immigrants [set defined? false]
  ask Immigrants[
    ifelse (nbChildren = 1) [set income 11931]
    [ifelse (nbChildren = 2) [set income 14853]
      [ifelse (nbChildren = 3) [set income 18260]
        [ifelse (nbChildren = 4) [set income 22170]
          [ifelse (nbChildren = 5) [set income 25145]
            [ifelse (nbChildren = 6) [set income 28359]
              [set income 31574]]]]]]]
  ask Immigrants [ifelse random-float 1 > 0.5 [set education "Superior"] [set education "None"]]
  ask n-of (0.651 * 3333) Immigrants [set language "French" set defined? true]
  ask n-of (0.049 * 3333) Immigrants with [defined? != true] [set language "English" set defined? true]
  ask Immigrants with [defined? != true] [set language "Both" set defined? true]
  ask Immigrants [set defined? false]

end

to segregate ;; asks immigrants to move to one of their suitable patches
  print "Unsatisfied Immigrants Moving to Their Choice Location"
  ask Immigrants with [not satisfied?] [ifelse count Choice5 with [not any? turtles-here] > 0 
    [move-to one-of Choice5 with[not any? turtles-here]]
      [if count Choice5 with [count turtles-here <= 2] > 0 
      [move-to one-of Choice5 with [count turtles-here <= 2]]]]

end

to satisfaction ; asks immigrants to check if there are 15 or fewer agents in their patch. If there are 15 or fewer, they are satisfied and therefore settled. If there are 15 or more, they are unsatisfied and will move on the next tick.
  print "Checking Immigrant Satisfaction"
  ask Immigrants
  [
    ifelse count Choice5 with [count turtles-here <= 15] > 0 [set satisfied? true]
    [set satisfied? false]
  ]
  print "Complete."

;  ask Immigrants ; "settled" variable is in V2, not V1
;  [
;    ifelse satisfied? = "True" [set settled 1]
;    [set settled 0]
;  ]
end


; I, JLK, am not the original author of the code, I've just helped comment it.]]></code>
  <widgets>
    <view x="458" wrappingAllowedX="false" y="55" frameRate="30.0" minPycor="0" height="635" showTickCounter="true" patchSize="2.10602" fontSize="10" wrappingAllowedY="false" width="739" tickCounterLabel="ticks" maxPycor="299" updateMode="1" maxPxcor="348" minPxcor="0"></view>
    <button x="203" y="55" height="88" disableUntilTicks="false" forever="false" kind="Observer" width="102" display="Setup">setup</button>
    <button x="310" y="55" height="88" disableUntilTicks="false" forever="true" kind="Observer" width="102">go</button>
    <plot x="203" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="Pct" y="197" xMin="0.0" height="198" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="Ticks" display="% Satisfaction">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="pen-0" color="-7500403" legend="true">
        <setup></setup>
        <update>plot count Immigrants with [satisfied?] / count Immigrants * 100</update>
      </pen>
    </plot>
    <monitor x="7" precision="2" y="383" height="60" fontSize="11" width="168" display="% Satisfied with Choice2"><![CDATA[count Immigrants with [count Choice2 > 0] / count Immigrants * 100]]></monitor>
    <monitor x="7" precision="2" y="448" height="60" fontSize="11" width="168" display="% Satisfied with Choice3"><![CDATA[count Immigrants with [count Choice3 > 0] / count Immigrants * 100]]></monitor>
    <monitor x="7" precision="2" y="513" height="60" fontSize="11" width="168" display="% Satisfied with Choice4"><![CDATA[count Immigrants with [count Choice4 > 0] / count Immigrants * 100]]></monitor>
    <monitor x="7" precision="2" y="578" height="60" fontSize="11" width="168" display="% Satisfied with Choice5"><![CDATA[count Immigrants with [count Choice5 > 0] / count Immigrants * 100]]></monitor>
    <button x="203" y="148" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="204">Export_To_Shapefile</button>
    <slider x="7" step="1" y="55" max="100" width="172" display="desired_neighbors" height="50" min="0" direction="Horizontal" default="25.0" variable="desired_neighbors"></slider>
    <slider x="7" step="1" y="157" max="100" width="172" display="nbBus" height="50" min="0" direction="Horizontal" default="10.0" variable="nbBus" units="Buses"></slider>
    <note x="15" y="213" backgroundDark="0" fontSize="11" width="150" markdown="false" height="28" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">This is for choosing the number of buses desired</note>
    <note x="17" y="110" backgroundDark="0" fontSize="11" width="150" markdown="false" height="42" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">This is for choosing the number of same ethnicity (percentage) neighborhood</note>
    <monitor x="7" precision="2" y="252" height="60" fontSize="11" width="155" display="Overall Immigrant Satisfaction">count Immigrants with [satisfied?] / count Immigrants * 100</monitor>
    <note x="11" y="10" backgroundDark="0" fontSize="25" width="815" markdown="false" height="33" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Mobility, Ethnicity, and Language-Based Immigrant Settlement</note>
    <monitor x="7" precision="2" y="318" height="60" fontSize="11" width="168" display="% Satistified with Choice1"><![CDATA[count Immigrants with [count Choice1 > 0] / count Immigrants * 100]]></monitor>
    <note x="204" y="406" backgroundDark="0" fontSize="14" width="205" markdown="false" height="372" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">INSTRUCTIONS

1) Adjust experiment parameters "desired_neighbors" and "nbBus" sliders in the top left.

2) Click Setup. Setup is complete when the button returns to its original colour.

2) Click go. The model run is over once the go button returns to its original colour Afterwards you may click Export_To_Shapefile to export data for processing in a GIS.</note>
  </widgets>
